# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local
.env.local
.env

# Live-stack secrets for the scripts/ probes. Deliberately NOT named .env.*
# at the project root: Expo's env loader claims anything matching that
# pattern and hands it to Metro, which then tries to parse the file as
# JavaScript and fails the whole bundle with "Unexpected token (1:0)".
# See scripts/probe-live-account.mjs for what reads this.
scripts/.live-secrets.env

# typescript
*.tsbuildinfo

app-example

# generated native folders
/ios
/android

# scratch dbs from the scripts/verify-*.ts checks (Stage 5). These are
# throwaway local PowerSync databases recreated on every run.
scripts/.verify-*.db*
scripts/.verify-enc-*.db*

# pg_dumps from scripts/backup-local-data.sh -- real account rows and real
# note bodies. Never commit these.
supabase/backups/

# build docs
mvp-build-plan.md
iteration-2-build-plan.md
prd.md
