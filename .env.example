# Copy this file and fill it in:
#
#     cp .env.example .env
#     node selfhost/generate-keys.mjs        # paste the output over the placeholders
#
# .env is gitignored. .env.example is committed. Never swap those round.
#
# Two audiences share this file. The EXPO_PUBLIC_* block is read by the mobile
# app; everything else is read by the self-hosted backend. If you are only
# building the app against a backend someone else runs, the EXPO_PUBLIC_* block
# is all you need.
#
# ==============================================================================
# THE APP
# ==============================================================================
#
# EXPO_PUBLIC_ is not decoration. Expo inlines any variable with that prefix
# into the JavaScript bundle at build time, so its value ships inside the app
# and anyone can read it out. Never put a secret behind that prefix. Everything
# else in this file stays on the server.
#
# Changing any of these requires a rebuild, not a reload -- the values are
# baked in at bundle time.

# Base URL of your Supabase API. Required.
# Self-hosted: http://<host>:8000 (Kong's port, KONG_HTTP_PORT below).
# Supabase Cloud: Project Settings -> API -> Project URL.
# Read at lib/supabase/client.ts:108
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:8000

# Public API key. Required. Safe to expose -- this is the ANON_KEY generated
# below, and RLS is what actually protects data, not secrecy of this key. The
# schema grants table privileges to `authenticated` only, never to `anon`.
# Read at lib/supabase/client.ts:109
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Base URL of your PowerSync service. Required.
# Self-hosted: http://<host>:8080 (POWERSYNC_HTTP_PORT below).
# PowerSync Cloud: the instance URL from the dashboard.
# Read at lib/powersync/connector.ts:310
EXPO_PUBLIC_POWERSYNC_URL=http://127.0.0.1:8080

# ==============================================================================
# THE SELF-HOSTED BACKEND
# ==============================================================================
# Only needed if you run selfhost/docker-compose.yml. All secret; none of these
# ever reach a device.

# --- Generated. Run `node selfhost/generate-keys.mjs` and paste. -------------

# Postgres superuser password, also applied to the Supabase service roles.
# Required. Avoid @ : / ? # in this value -- it goes into connection URIs, where
# those characters silently truncate the string.
# Read at selfhost/docker-compose.yml, selfhost/init/01-roles.sql
POSTGRES_PASSWORD=

# Signs every JWT the stack issues and verifies. Required, minimum 32
# characters. Changing it invalidates ANON_KEY, SERVICE_ROLE_KEY and every
# session that has already been handed out.
# Read by GoTrue, PostgREST and PowerSync (selfhost/powersync/config.yaml)
JWT_SECRET=

# A JWT with role=anon, signed by JWT_SECRET. Required. Same value as
# EXPO_PUBLIC_SUPABASE_ANON_KEY above.
ANON_KEY=

# A JWT with role=service_role, signed by JWT_SECRET. Required.
# BYPASSES ROW LEVEL SECURITY ENTIRELY. Server-side scripts only. If this
# reaches a client, every row in the database is readable by anyone.
SERVICE_ROLE_KEY=

# Password for powersync_role, the replication role that reads the write-ahead
# log. Required. The migration creates the role with no password on purpose --
# selfhost/migrate.sh applies this one. Without it PowerSync fails 28P01 and
# replicates nothing while every container still reports healthy.
# Read at selfhost/docker-compose.yml, selfhost/migrate.sh,
# docker-compose.yml:31 and scripts/reset-local-db.sh:43
POWERSYNC_REPLICATION_PASSWORD=

# --- Addresses ---------------------------------------------------------------

# The URL clients reach the API on from outside the Docker network. Required.
# Must be what a phone can actually resolve -- not localhost, if the phone is
# not the machine running Docker. Wrong value = email links that go nowhere.
API_EXTERNAL_URL=http://127.0.0.1:8000

# Where auth redirects land after a sign-in. Optional; the default is the app's
# deep-link scheme, declared as `scheme` in app.json.
SITE_URL=notes://

# Extra redirect URLs to allow, comma-separated. Optional. Add your web origin
# here if you serve the web build.
ADDITIONAL_REDIRECT_URLS=notes://*

# --- Host ports. Optional; change if something already uses them. ------------
# On a public server, put a TLS terminating proxy in front and bind these to
# 127.0.0.1 instead of exposing them.
KONG_HTTP_PORT=8000
POWERSYNC_HTTP_PORT=8080
POSTGRES_HOST_PORT=5432
STUDIO_PORT=8001
MAILPIT_PORT=8025

# --- Email --------------------------------------------------------------------
# Sign-in is a 6-digit code sent by email, so without working SMTP nobody can
# sign in. The defaults point at the bundled Mailpit container, which catches
# mail in a web inbox at http://127.0.0.1:8025 instead of delivering it --
# fine for trying the stack out, useless for real use.
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_ADMIN_EMAIL=notes@localhost
SMTP_SENDER_NAME=Notes

# Optional, default true, and leave it that way unless you know why not.
# It only skips the separate confirm-your-address step at signup; it does not
# weaken anything, because the only way into this app is a code emailed to that
# same address. Set it false and new users get a "confirm your email" link
# instead of the 6-digit code the app asks them to type.
MAILER_AUTOCONFIRM=true

# Close signups once your own devices are enrolled. Optional, default false.
DISABLE_SIGNUP=false

# How long an access token lives, in seconds. Optional, default 3600.
JWT_EXPIRY=3600

# --- Google sign-in. Optional; leave GOOGLE_ENABLED=false to skip. ------------
# From Google Cloud Console -> APIs & Services -> Credentials -> OAuth client.
# Authorised redirect URI must be <API_EXTERNAL_URL>/auth/v1/callback. Google
# will not accept a private IP address there, so this needs a real domain.
GOOGLE_ENABLED=false
# Read at supabase/config.toml:471
SUPABASE_AUTH_GOOGLE_CLIENT_ID=
# Read at supabase/config.toml:472
SUPABASE_AUTH_GOOGLE_SECRET=

# --- Studio, the admin dashboard. Optional. ----------------------------------
STUDIO_DEFAULT_ORGANIZATION=Notes
STUDIO_DEFAULT_PROJECT=Notes

# ==============================================================================
# MAINTAINER SCRIPTS
# ==============================================================================
# Only read by scripts/probe-unlink-last-identity.ts, which is a diagnostic for
# Supabase's "cannot unlink your last identity" behaviour. Both optional; you
# will not need either unless you are working on account linking.

# Account the probe runs against. Optional; the script has its own default.
# Read at scripts/probe-unlink-last-identity.ts:22
PROBE_EMAIL=

# Set to 1 to let the probe actually perform the unlink. Optional. Left unset,
# the script stops before making the change.
# Read at scripts/probe-unlink-last-identity.ts:66
ALLOW_UNLINK=
